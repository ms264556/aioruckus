aioruckus/_version.py

# Ruckus device backups. A raw dump carries live WLAN passphrases, admin
# credentials, client MACs and operator IPs, so *.bak is ignored wherever it
# is downloaded to. The fixtures the backup tests run against are redacted,
# and tests/live/backups/ is the only place a .bak may be committed from.
*.bak
!tests/live/backups/*.bak

# Unredacted captures, kept out of the fixtures directory above so that
# whitelist cannot stage them. These are the source material for rebuilding
# those fixtures; never commit anything from here.
tests/live/raw-backups/

